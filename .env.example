# Copy this file to `.env` and adjust for your environment.
# NOTE: every VITE_* variable is bundled into the frontend build and is
# publicly visible. Never put secrets here — only public configuration.

# Base URL of the backend API (no trailing slash)
# for local
VITE_API_BASE_URL=http://localhost:5000

# For production
# VITE_API_BASE_URL=https://sneh-jeet-backend.onrender.com
